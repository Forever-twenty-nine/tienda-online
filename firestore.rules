rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Cualquier visitante (anonimo) puede LEER productos, rubros, categorias,
    // subcategorias, paginas legales y contact. Solo el admin (custom claim
    // `admin: true` en su idToken) puede ESCRIBIR.
    //
    // Reglas explicitas por collection para que sea evidente que el patron
    // es uniforme. Si se agrega una collection nueva, sumar una linea.
    match /products/{productId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }
    match /rubros/{rubroId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }
    match /subcategories/{subcategoryId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }
    match /pages/{pageId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }
    match /contact/{contactId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }
  }
}
