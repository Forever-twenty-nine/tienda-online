rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Cualquier visitante (anonimo) puede LEER imagenes (visitantes ven el
    // catalogo). Solo el admin (custom claim `admin: true`) puede ESCRIBIR.
    //
    // Cubre tanto `products/{slug}/*` (imagenes de productos subidas desde
    // el admin) como `home/*` (assets de la landing).
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }
  }
}
